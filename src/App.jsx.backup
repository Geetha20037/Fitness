function WorkoutSection({
  completedWorkouts,
  onComplete,
}) {
  const [category, setCategory] = useState("All");

  const filteredWorkouts = workouts.filter(
    (workout) =>
      category === "All" || workout.category === category,
  );

  return (
    <section id="workouts" className="section-anchor py-10 sm:py-14">
      <SectionTitle
        eyebrow="Move with purpose"
        title="Find your workout"
        description="Choose a session that fits your energy, your schedule, and your goals."
        action={
          <span className="text-xs text-[#858b7e]">
            {filteredWorkouts.length} sessions
          </span>
        }
      />

      <div className="mb-6 flex flex-wrap gap-2">
        {categories.map((item) => (
          <button
            type="button"
            key={item}
            onClick={() => setCategory(item)}
            className={`rounded-xl border px-4 py-2.5 text-xs font-semibold transition-colors ${
              category === item
                ? "border-[#c1fa70] bg-[#c1fa70] text-[#11140d]"
                : "border-[#30362b] bg-[#191c17] text-[#aeb4a5] hover:border-[#59634c] hover:text-white"
            }`}
          >
            {item}
          </button>
        ))}
      </div>

      <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {filteredWorkouts.map((workout) => (
          <WorkoutCard
            key={workout.id}
            workout={workout}
            completed={completedWorkouts.includes(workout.id)}
            onComplete={onComplete}
          />
        ))}
      </div>
    </section>
  );
}

function ProgressSection({ stats, activity }) {
  const [range, setRange] = useState("7");

  const chartData = useMemo(() => {
    const count = Number(range);
    return activity.slice(-count);
  }, [activity, range]);

  const averageSteps = Math.round(
    chartData.reduce((sum, day) => sum + day.steps, 0) /
      Math.max(chartData.length, 1),
  );

  const totalCalories = chartData.reduce(
    (sum, day) => sum + day.calories,
    0,
  );

  return (
    <section id="progress" className="section-anchor py-10 sm:py-14">
      <SectionTitle
        eyebrow="Your growth, visualized"
        title="Progress that motivates"
        description="Look back at your activity and celebrate the small wins that build consistency."
      />

      <div className="grid gap-5 lg:grid-cols-[1.5fr_0.8fr]">
        <div className="panel min-w-0 p-4 sm:p-6">
          <div className="flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
            <div>
              <h3 className="font-display text-lg font-bold">
                Steps & activity
              </h3>
              <p className="mt-1 text-xs text-[#858b7e]">
                Review your recent movement
              </p>
            </div>

            <select
              value={range}
              onChange={(event) => setRange(event.target.value)}
              aria-label="Activity chart range"
              className="input-dark w-auto min-w-[115px] text-xs"
            >
              <option value="7">7 days</option>
              <option value="5">5 days</option>
              <option value="3">3 days</option>
            </select>
          </div>

          <div className="mt-6 h-[250px] w-full">
            <ResponsiveContainer width="100%" height="100%">
              <AreaChart
                data={chartData}
                margin={{ top: 8, right: 6, left: -17, bottom: 0 }}
              >
                <defs>
                  <linearGradient
                    id="progressGradient"
                    x1="0"
                    y1="0"
                    x2="0"
                    y2="1"
                  >
                    <stop
                      offset="0%"
                      stopColor="#A6A0FF"
                      stopOpacity={0.28}
                    />
                    <stop
                      offset="100%"
                      stopColor="#A6A0FF"
                      stopOpacity={0}
                    />
                  </linearGradient>
                </defs>

                <CartesianGrid
                  stroke="#2b3027"
                  strokeDasharray="4 5"
                  vertical={false}
                />

                <XAxis
                  dataKey="day"
                  axisLine={false}
                  tickLine={false}
                  tick={{ fill: "#858b7e", fontSize: 11 }}
                  dy={9}
                />

                <YAxis
                  axisLine={false}
                  tickLine={false}
                  tick={{ fill: "#858b7e", fontSize: 10 }}
                  tickFormatter={(value) =>
                    value >= 1000
                      ? `${(value / 1000).toFixed(0)}k`
                      : value
                  }
                />

                <Tooltip
                  {...chartTooltipStyle}
                  formatter={(value) => [
                    Number(value).toLocaleString("en-IN"),
                    "Steps",
                  ]}
                />

                <Area
                  type="monotone"
                  dataKey="steps"
                  stroke="#A6A0FF"
                  strokeWidth={2.5}
                  fill="url(#progressGradient)"
                  activeDot={{ r: 5, fill: "#A6A0FF" }}
                />
              </AreaChart>
            </ResponsiveContainer>
          </div>
        </div>

        <div className="flex flex-col gap-4">
          <div className="panel flex-1 p-5">
            <span className="flex h-10 w-10 items-center justify-center rounded-xl bg-[#a6a0ff18] text-[#a6a0ff]">
              <Footprints size={21} />
            </span>
            <p className="mt-5 text-xs text-[#858b7e]">
              Average daily steps
            </p>
            <p className="metric-number mt-1 text-3xl font-extrabold">
              {averageSteps.toLocaleString("en-IN")}
            </p>
            <p className="mt-3 flex items-center gap-1 text-xs text-[#a6a0ff]">
              <TrendingUp size={14} />
              Across {chartData.length} days
            </p>
          </div>

          <div className="panel flex-1 p-5">
            <span className="flex h-10 w-10 items-center justify-center rounded-xl bg-[#ff9e8618] text-[#ff9e86]">
              <Flame size={21} />
            </span>
            <p className="mt-5 text-xs text-[#858b7e]">
              Total recorded calories
            </p>
            <p className="metric-number mt-1 text-3xl font-extrabold">
              {totalCalories.toLocaleString("en-IN")}
            </p>
            <p className="mt-3 text-xs text-[#858b7e]">
              Historical activity sample
            </p>
          </div>
        </div>
      </div>

      <div className="panel mt-5 p-5 sm:p-6">
        <div className="flex items-start justify-between gap-3">
          <div>
            <h3 className="font-display text-lg font-bold">
              Today&apos;s movement
            </h3>
            <p className="mt-1 text-xs text-[#858b7e]">
              Your current dashboard totals
            </p>
          </div>
          <Trophy size={21} className="text-[#c1fa70]" />
        </div>

        <div className="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-4">
          {[
            {
              label: "Steps",
              value: stats.steps.toLocaleString("en-IN"),
              color: "#C1FA70",
            },
            {
              label: "Calories",
              value: `${stats.calories} kcal`,
              color: "#FF9E86",
            },
            {
              label: "Active time",
              value: `${stats.minutes} min`,
              color: "#A6A0FF",
            },
            {
              label: "Heart rate",
              value: `${stats.heartRate} bpm`,
              color: "#FF8EAA",
            },
          ].map((item) => (
            <div
              key={item.label}
              className="rounded-xl border border-[#30362b] bg-[#141611] p-3 sm:p-4"
            >
              <span
                className="text-[10px] font-semibold"
                style={{ color: item.color }}
              >
                {item.label}
              </span>
              <p className="mt-2 break-words text-lg font-extrabold sm:text-xl">
                {item.value}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  );
}

function NutritionSection() {
  const dailyTotals = meals.reduce(
    (totals, meal) => ({
      calories: totals.calories + meal.calories,
      protein: totals.protein + meal.protein,
      carbs: totals.carbs + meal.carbs,
      fat: totals.fat + meal.fat,
    }),
    { calories: 0, protein: 0, carbs: 0, fat: 0 },
  );

  const calorieTarget = 2000;

  return (
    <section id="nutrition" className="section-anchor py-10 sm:py-14">
      <SectionTitle
        eyebrow="Fuel your body"
        title="Eat well. Feel great."
        description="Explore balanced meal ideas and see how their estimated nutrients add up."
      />

      <div
        id="nutrition-summary"
        className="panel mb-5 p-5 sm:p-6"
      >
        <div className="flex flex-col justify-between gap-5 sm:flex-row sm:items-center">
          <div className="flex items-center gap-3">
            <span className="flex h-12 w-12 items-center justify-center rounded-2xl bg-[#c1fa7018] text-[#c1fa70]">
              <Utensils size={22} />
            </span>
            <div>
              <h3 className="font-display text-lg font-bold">
                Sample daily nutrition
              </h3>
              <p className="mt-1 text-xs text-[#858b7e]">
                Based on the meal examples below
              </p>
            </div>
          </div>

          <div>
            <p className="metric-number text-3xl font-extrabold">
              {dailyTotals.calories.toLocaleString("en-IN")}
              <span className="ml-1 text-xs font-medium text-[#858b7e]">
                kcal
              </span>
            </p>
            <p className="mt-1 text-xs text-[#858b7e]">
              of a sample {calorieTarget.toLocaleString("en-IN")} kcal reference
            </p>
            <div className="progress-track mt-3 w-full sm:w-48">
              <div
                className="progress-fill"
                style={{
                  width: `${Math.min(
                    100,
                    (dailyTotals.calories / calorieTarget) * 100,
                  )}%`,
                }}
              />
            </div>
          </div>
        </div>

        <div className="mt-5 grid grid-cols-3 gap-3 border-t border-[#2b3027] pt-5 sm:grid-cols-4">
          {[
            ["Protein", dailyTotals.protein, "g", "#C1FA70"],
            ["Carbs", dailyTotals.carbs, "g", "#A6A0FF"],
            ["Fat", dailyTotals.fat, "g", "#FF9E86"],
          ].map(([label, value, unit, color]) => (
            <div key={label} className="min-w-0">
              <p className="text-xs text-[#858b7e]">{label}</p>
              <p className="mt-1 text-xl font-extrabold">
                {value}
                <span className="ml-1 text-xs font-medium text-[#858b7e]">
                  {unit}
                </span>
              </p>
              <div
                className="mt-2 h-1 w-full rounded-full"
                style={{ backgroundColor: color }}
              />
            </div>
          ))}

          <div className="col-span-3 rounded-lg bg-[#141611] p-3 sm:col-span-1">
            <p className="text-[10px] leading-5 text-[#858b7e]">
              Values are illustrative meal estimates, not personalized
              dietary targets.
            </p>
          </div>
        </div>
      </div>

      <div className="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {meals.map((meal) => (
          <MealCard key={meal.id} meal={meal} />
        ))}
      </div>
    </section>
  );
}

function GoalsSection({ goals, onUpdateGoal }) {
  const completed = goals.filter(
    (goal) => goal.current >= goal.target,
  ).length;

  return (
    <section id="goals" className="section-anchor py-10 sm:py-14">
      <SectionTitle
        eyebrow="Little wins, big changes"
        title="Goals worth showing up for"
        description="Track your daily targets, add progress, and celebrate each milestone."
        action={
          <span className="flex w-fit items-center gap-2 rounded-full border border-[#c1fa7030] bg-[#c1fa7010] px-3 py-2 text-xs font-semibold text-[#c1fa70]">
            <CheckCircle2 size={14} />
            {completed}/{goals.length} achieved
          </span>
        }
      />

      <div className="grid gap-4 md:grid-cols-3">
        {goals.map((goal) => (
          <GoalCard
            key={goal.id}
            goal={goal}
            onUpdate={onUpdateGoal}
          />
        ))}
      </div>

      <div className="panel mt-5 flex flex-col justify-between gap-4 p-5 sm:flex-row sm:items-center sm:p-6">
        <div className="flex items-start gap-3">
          <span className="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#c1fa7018] text-[#c1fa70]">
            <Sparkles size={21} />
          </span>
          <div>
            <h3 className="font-display text-base font-bold">
              Progress is progress.
            </h3>
            <p className="mt-1 max-w-xl text-xs leading-5 text-[#858b7e]">
              You don&apos;t need a perfect day. Small, consistent
              actions are a great way to build lasting habits.
            </p>
          </div>
        </div>

        <a href="#workouts" className="btn-primary shrink-0">
          Find a workout <ArrowRight size={15} />
        </a>
      </div>
    </section>
  );
}

function ContactSection() {
  const [form, setForm] = useState({
    name: "",
    email: "",
    message: "",
  });
  const [feedback, setFeedback] = useState("");

  function handleSubmit(event) {
    event.preventDefault();

    const name = form.name.trim();
    const email = form.email.trim();
    const message = form.message.trim();

    if (!name || !email || !message) {
      setFeedback("Please complete all fields.");
      return;
    }

    const subject = encodeURIComponent(
      `PULSEFIT enquiry from ${name}`,
    );
    const body = encodeURIComponent(
      `Name: ${name}\nEmail: ${email}\n\n${message}`,
    );

    setFeedback(
      "Your email app will open with the message prepared. Send it there to complete delivery.",
    );

    window.location.href =
      `mailto:hello@pulsefit.example?subject=${subject}&body=${body}`;
  }

  return (
    <section className="section-anchor py-10 sm:py-14">
      <div className="grid gap-6 lg:grid-cols-[0.85fr_1.15fr]">
        <div className="py-2">
          <SectionLabel>Let&apos;s connect</SectionLabel>
          <h2 className="font-display text-3xl font-extrabold leading-tight sm:text-4xl">
            Your next chapter
            <br />
            starts <span className="text-[#c1fa70]">here.</span>
          </h2>
          <p className="mt-4 max-w-md text-sm leading-7 text-[#858b7e]">
            Have a question, a feature idea, or feedback about your
            fitness journey? Send a message using the form.
          </p>

          <div className="mt-7 flex items-center gap-3">
            <span className="flex h-11 w-11 items-center justify-center rounded-xl bg-[#c1fa7018] text-[#c1fa70]">
              <MessageCircle size={21} />
            </span>
            <div>
              <p className="text-xs text-[#858b7e]">Contact email</p>
              <p className="mt-1 text-sm font-semibold">
                hello@pulsefit.example
              </p>
            </div>
          </div>
        </div>

        <form
          onSubmit={handleSubmit}
          className="panel space-y-4 p-5 sm:p-7"
        >
          <div>
            <label
              htmlFor="contact-name"
              className="mb-2 block text-xs font-semibold text-[#c3c8bc]"
            >
              Your name
            </label>
            <input
              id="contact-name"
              className="input-dark"
              value={form.name}
              onChange={(event) =>
                setForm({ ...form, name: event.target.value })
              }
              placeholder="Enter your name"
              maxLength={100}
              required
            />
          </div>

          <div>
            <label
              htmlFor="contact-email"
              className="mb-2 block text-xs font-semibold text-[#c3c8bc]"
            >
              Email address
            </label>
            <input
              id="contact-email"
              className="input-dark"
              type="email"
              value={form.email}
              onChange={(event) =>
                setForm({ ...form, email: event.target.value })
              }
              placeholder="you@example.com"
              maxLength={254}
              required
            />
          </div>

          <div>
            <label
              htmlFor="contact-message"
              className="mb-2 block text-xs font-semibold text-[#c3c8bc]"
            >
              Message
            </label>
            <textarea
              id="contact-message"
              className="input-dark min-h-28 resize-y"
              value={form.message}
              onChange={(event) =>
                setForm({ ...form, message: event.target.value })
              }
              placeholder="How can we help?"
              maxLength={2000}
              required
            />
          </div>

          {feedback && (
            <p
              role="status"
              className="text-xs leading-5 text-[#c1fa70]"
            >
              {feedback}
            </p>
          )}

          <button type="submit" className="btn-primary w-full">
            Prepare message <Send size={15} />
          </button>

          <p className="text-[10px] leading-5 text-[#777e70]">
            This demo prepares a message in your default email app. It
            does not send messages through a backend.
          </p>
        </form>
      </div>
    </section>
  );
}

function FloatingAction({ onReset }) {
  const [open, setOpen] = useState(false);

  return (
    <div className="fixed bottom-5 right-4 z-40 flex flex-col items-end gap-3 sm:bottom-6 sm:right-6">
      {open && (
        <div className="panel w-[220px] p-2 shadow-2xl">
          <a
            href="#dashboard"
            onClick={() => setOpen(false)}
            className="flex items-center gap-3 rounded-lg px-3 py-3 text-xs text-[#c3c8bc] hover:bg-[#ffffff08]"
          >
            <Activity size={16} className="text-[#c1fa70]" />
            Open dashboard
          </a>
          <a
            href="#workouts"
            onClick={() => setOpen(false)}
            className="flex items-center gap-3 rounded-lg px-3 py-3 text-xs text-[#c3c8bc] hover:bg-[#ffffff08]"
          >
            <Zap size={16} className="text-[#c1fa70]" />
            Start a workout
          </a>
          <button
            type="button"
            onClick={() => {
              setOpen(false);
              onReset();
            }}
            className="flex w-full items-center gap-3 rounded-lg px-3 py-3 text-xs text-[#c3c8bc] hover:bg-[#ffffff08]"
          >
            <Activity size={16} className="text-[#c1fa70]" />
            Reset daily totals
          </button>
        </div>
      )}

      <button
        type="button"
        onClick={() => setOpen(!open)}
        aria-label={open ? "Close quick actions" : "Open quick actions"}
        aria-expanded={open}
        className="pulse-animation flex h-12 w-12 items-center justify-center rounded-2xl bg-[#c1fa70] text-[#11140d] shadow-xl transition-transform hover:scale-105"
      >
        {open ? <X size={21} /> : <Plus size={23} />}
      </button>
    </div>
  );
}

export default function App() {
  const [saved] = useState(loadSavedData);

  const [stats, setStats] = useState(saved.stats);
  const [goals, setGoals] = useState(saved.goals);
  const [completedWorkouts, setCompletedWorkouts] = useState(
    saved.completedWorkouts,
  );
  const [activity, setActivity] = useState(saved.activity);
  const [notice, setNotice] = useState("");

  useEffect(() => {
    try {
      localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({
          stats,
          goals,
          completedWorkouts,
          activity,
        }),
      );
    } catch (error) {
      console.error("Unable to save PULSEFIT data:", error);
    }
  }, [stats, goals, completedWorkouts, activity]);

  useEffect(() => {
    if (!notice) return undefined;

    const timeout = window.setTimeout(() => {
      setNotice("");
    }, 3500);

    return () => window.clearTimeout(timeout);
  }, [notice]);

  function updateGoal(goalId, amount) {
    setGoals((currentGoals) =>
      currentGoals.map((goal) =>
        goal.id === goalId
          ? {
              ...goal,
              current: Math.min(
                goal.target,
                goal.current + amount,
              ),
            }
          : goal,
      ),
    );
  }

  function handleUpdateGoal(goalId) {
    const goal = goals.find((item) => item.id === goalId);

    if (!goal || goal.current >= goal.target) {
      setNotice("This goal has already been achieved.");
      return;
    }

    const amount =
      goalId === 1 ? 500 : goalId === 2 ? 50 : 10;

    updateGoal(goalId, amount);

    if (goalId === 1) {
      setStats((current) => ({
        ...current,
        steps: current.steps + 500,
      }));
    }

    if (goalId === 2) {
      setStats((current) => ({
        ...current,
        calories: current.calories + 50,
      }));
    }

    if (goalId === 3) {
      setStats((current) => ({
        ...current,
        minutes: current.minutes + 10,
      }));
    }

    setNotice(`Progress updated: ${goal.title}`);
  }

  function handleWorkoutComplete(workout) {
    if (completedWorkouts.includes(workout.id)) {
      setNotice(`${workout.name} is already marked complete.`);
      return;
    }

    setCompletedWorkouts((current) => [
      ...current,
      workout.id,
    ]);

    setStats((current) => ({
      ...current,
      calories: current.calories + workout.calories,
      minutes: current.minutes + workout.duration,
    }));

    setGoals((currentGoals) =>
      currentGoals.map((goal) => {
        if (goal.id === 2) {
          return {
            ...goal,
            current: Math.min(
              goal.target,
              goal.current + workout.calories,
            ),
          };
        }

        if (goal.id === 3) {
          return {
            ...goal,
            current: Math.min(
              goal.target,
              goal.current + workout.duration,
            ),
          };
        }

        return goal;
      }),
    );

    setActivity((current) =>
      current.map((day, index) =>
        index === current.length - 1
          ? {
              ...day,
              calories: day.calories + workout.calories,
            }
          : day,
      ),
    );

    setNotice(
      `${workout.name} completed! Great job showing up.`,
    );
  }

  function handleReset() {
    const confirmed = window.confirm(
      "Reset today's dashboard totals, goals, and completed workouts? This cannot be undone.",
    );

    if (!confirmed) return;

    setStats(initialStats);
    setGoals(initialGoals);
    setCompletedWorkouts([]);
    setActivity(weeklyActivity);
    setNotice("Dashboard data has been reset.");
  }

  return (
    <div className="app-shell min-h-screen">
      <Navbar />

      <main className="page-container">
        <Hero stats={stats} />

        <DashboardSection
          stats={stats}
          goals={goals}
          activity={activity}
          completedWorkouts={completedWorkouts}
          onUpdateGoal={handleUpdateGoal}
        />

        <div className="border-t border-[#2b3027]" />

        <WorkoutSection
          completedWorkouts={completedWorkouts}
          onComplete={handleWorkoutComplete}
        />

        <div className="border-t border-[#2b3027]" />

        <ProgressSection
          stats={stats}
          activity={activity}
        />

        <div className="border-t border-[#2b3027]" />

        <NutritionSection />

        <div className="border-t border-[#2b3027]" />

        <GoalsSection
          goals={goals}
          onUpdateGoal={handleUpdateGoal}
        />

        <div className="border-t border-[#2b3027]" />

        <section
          id="bmi"
          className="section-anchor py-10 sm:py-14"
        >
          <div className="grid items-start gap-5 lg:grid-cols-2">
            <div className="py-2">
              <SectionLabel>Know your numbers</SectionLabel>
              <h2 className="font-display text-3xl font-extrabold leading-tight sm:text-4xl">
                Understand your
                <br />
                <span className="text-[#c1fa70]">
                  fitness baseline.
                </span>
              </h2>
              <p className="mt-4 max-w-lg text-sm leading-7 text-[#858b7e]">
                Use this simple BMI calculator to explore your body
                mass index. Pair the result with your overall health,
                strength, nutrition, and personal goals.
              </p>

              <div className="mt-6 grid grid-cols-2 gap-3">
                <div className="panel p-4">
                  <Heart size={19} className="text-[#ff9e86]" />
                  <p className="mt-3 text-sm font-bold">
                    Overall wellness
                  </p>
                  <p className="mt-1 text-xs leading-5 text-[#858b7e]">
                    Look beyond one number.
                  </p>
                </div>
                <div className="panel p-4">
                  <TrendingUp size={19} className="text-[#c1fa70]" />
                  <p className="mt-3 text-sm font-bold">
                    Steady progress
                  </p>
                  <p className="mt-1 text-xs leading-5 text-[#858b7e]">
                    Build sustainable habits.
                  </p>
                </div>
              </div>
            </div>

            <BMICalculator />
          </div>
        </section>

        <div className="border-t border-[#2b3027]" />

        <ContactSection />
      </main>

      <Footer />

      {notice && (
        <motion.div
          initial={{ opacity: 0, y: 16 }}
          animate={{ opacity: 1, y: 0 }}
          exit={{ opacity: 0, y: 8 }}
          role="status"
          className="fixed bottom-20 left-4 right-4 z-50 mx-auto flex max-w-md items-start gap-3 rounded-xl border border-[#c1fa7040] bg-[#1b2116] p-4 shadow-2xl sm:bottom-6"
        >
          <span className="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#c1fa7018] text-[#c1fa70]">
            <CheckCircle2 size={18} />
          </span>
          <p className="flex-1 pt-1 text-xs leading-5 text-[#e1e6d9]">
            {notice}
          </p>
          <button
            type="button"
            onClick={() => setNotice("")}
            aria-label="Dismiss notification"
            className="p-1 text-[#858b7e] hover:text-white"
          >
            <X size={16} />
          </button>
        </motion.div>
      )}

      <FloatingAction onReset={handleReset} />
    </div>
  );
}