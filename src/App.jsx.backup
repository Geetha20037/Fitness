                    r: 5,
                    fill: "#C1FA70",
                    stroke: "#10120f",
                    strokeWidth: 2,
                  }}
                />
              </AreaChart>
            </ResponsiveContainer>
          </div>

          <div className="mt-3 flex items-center gap-2 text-[11px] text-[#858b7e]">
            <TrendingUp size={15} className="text-[#c1fa70]" />
            Keep showing up. Every active day adds up.
          </div>
        </div>

        <div className="panel p-5 sm:p-6">
          <div className="flex items-center justify-between gap-3">
            <div>
              <h3 className="font-display text-lg font-bold">
                Daily step goal
