                    done
                      ? "border-[#c1fa7040] bg-[#c1fa7012] text-[#c1fa70]"
                      : "border-[#30362b] text-[#858b7e]"
                  }`}
                >
                  {done && <Check size={10} className="mr-1 inline" />}
                  {workout.name}
                </span>
              );
            })}
          </div>
        </div>

        <div className="panel p-5 sm:p-6">
          <div className="flex items-center justify-between gap-3">
            <div>
              <h3 className="font-display text-lg font-bold">
                Activity by day
              </h3>
              <p className="mt-1 text-xs text-[#858b7e]">
                Daily calories burned
              </p>
            </div>
            <span className="flex h-10 w-10 items-center justify-center rounded-xl bg-[#c1fa7015] text-[#c1fa70]">
              <Activity size={20} />
            </span>
          </div>

          <div className="mt-5 h-[165px] w-full">
            <ResponsiveContainer width="100%" height="100%">
              <BarChart
                data={chartData}
                margin={{ top: 8, right: 0, left: -25, bottom: 0 }}
