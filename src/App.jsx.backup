  CheckCircle2,
  ChevronRight,
  Clock3,
  Flame,
  Footprints,
  Heart,
  Menu,
  MessageCircle,
  Moon,
  Plus,
  Send,
  Sparkles,
  Target,
  TrendingUp,
  Trophy,
  Utensils,
