} from "lucide-react";
import {
  Area,
  AreaChart,
  CartesianGrid,
  ResponsiveContainer,
  Tooltip,
  XAxis,
  YAxis,
  Bar,
  BarChart,
  Cell,
} from "recharts";

import Navbar from "./components/Navbar.jsx";
import StatCard from "./components/StatCard.jsx";
import SectionTitle from "./components/SectionTitle.jsx";
import WorkoutCard from "./components/WorkoutCard.jsx";
import MealCard from "./components/MealCard.jsx";
import GoalCard from "./components/GoalCard.jsx";
import BMICalculator from "./components/BMICalculator.jsx";
import Footer from "./components/Footer.jsx";

import {
  workouts,
  meals,
  initialGoals,
  weeklyActivity,
  initialStats,
} from "./data.js";

const STORAGE_KEY = "pulsefit-dashboard-v1";

const categories = ["All", "Cardio", "Strength", "Yoga", "HIIT"];

const chartTooltipStyle = {
  contentStyle: {
    background: "#20231d",
    border: "1px solid #3a4034",
    borderRadius: "10px",
    color: "#f5f6f2",
    fontSize: "12px",
  },
  labelStyle: {
    color: "#c1fa70",
    marginBottom: "5px",
  },
};

function loadSavedData() {
  try {
    const saved = localStorage.getItem(STORAGE_KEY);

    if (saved) {
      const parsed = JSON.parse(saved);

      return {
        stats: {
          ...initialStats,
          ...(parsed.stats || {}),
        },
        goals: Array.isArray(parsed.goals)
          ? parsed.goals
          : initialGoals,
        completedWorkouts: Array.isArray(
          parsed.completedWorkouts,
        )
          ? parsed.completedWorkouts
          : [],
        activity: Array.isArray(parsed.activity)
          ? parsed.activity
          : weeklyActivity,
      };
    }
  } catch (error) {
    console.error("Unable to load PULSEFIT data:", error);
  }

  return {
    stats: initialStats,
    goals: initialGoals,
    completedWorkouts: [],
    activity: weeklyActivity,
  };
}

function SectionLabel({ children }) {
  return (
    <span className="eyebrow mb-3 inline-flex items-center gap-2">
      <span className="h-1.5 w-1.5 rounded-full bg-[#c1fa70]" />
      {children}
    </span>
  );
}

function DashboardHeading({ title, subtitle }) {
  return (
    <div className="mb-6">
      <p className="text-xs text-[#858b7e]">{subtitle}</p>
      <h2 className="font-display mt-1 text-2xl font-extrabold tracking-tight sm:text-3xl">
        {title}
      </h2>
    </div>
  );
}

function CircularProgress({ value, total, size = 144 }) {
  const radius = 51;
  const circumference = 2 * Math.PI * radius;
  const percentage = Math.max(
    0,
    Math.min(100, (value / total) * 100),
  );

  return (
    <div
      className="relative shrink-0"
      style={{ width: size, height: size }}
      role="img"
      aria-label={`${Math.round(percentage)} percent of step goal completed`}
    >
      <svg
        viewBox="0 0 120 120"
        width="100%"
        height="100%"
        className="-rotate-90"
      >
        <circle
          cx="60"
          cy="60"
          r={radius}
          fill="none"
          stroke="#30352c"
          strokeWidth="9"
        />
        <motion.circle
          cx="60"
          cy="60"
          r={radius}
          fill="none"
          stroke="#c1fa70"
          strokeWidth="9"
          strokeLinecap="round"
          strokeDasharray={circumference}
          initial={{ strokeDashoffset: circumference }}
          animate={{
            strokeDashoffset:
              circumference -
              (percentage / 100) * circumference,
          }}
          transition={{ duration: 1.1, ease: "easeOut" }}
        />
      </svg>

      <div className="absolute inset-0 flex flex-col items-center justify-center">
        <Footprints size={19} className="mb-1 text-[#c1fa70]" />
        <span className="font-display text-xl font-extrabold">
          {Math.round(percentage)}%
        </span>
        <span className="text-[9px] text-[#858b7e]">completed</span>
      </div>
    </div>
  );
}

function DashboardSection({
  stats,
  goals,
  activity,
  completedWorkouts,
  onUpdateGoal,
}) {
