    weekday: "long",
    day: "numeric",
    month: "long",
  });

  const stepGoal =
    goals.find((goal) => goal.id === 1)?.target || 10000;

  const stepsProgress = Math.min(
    100,
    (stats.steps / stepGoal) * 100,
  );

  const activeGoal =
    goals.find((goal) => goal.id === 3)?.target || 60;

  const activeProgress = Math.min(
    100,
    (stats.minutes / activeGoal) * 100,
  );

  const [metric, setMetric] = useState("steps");

  const chartData = activity.map((day) => ({
    ...day,
    steps: day.steps,
    calories: day.calories,
  }));

  return (
    <section id="dashboard" className="section-anchor py-10 sm:py-14">
      <div className="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <SectionLabel>Your daily overview</SectionLabel>
          <h2 className="font-display text-2xl font-extrabold sm:text-3xl">
            Your fitness dashboard
          </h2>
          <p className="mt-2 text-sm text-[#858b7e]">
            Here&apos;s what your movement looks like today.
          </p>
        </div>

        <div className="inline-flex w-fit items-center gap-2 rounded-xl border border-[#30362b] bg-[#191c17] px-3 py-2.5 text-xs text-[#b9beb1]">
          <CalendarDays size={15} className="text-[#c1fa70]" />
          {today}
        </div>
      </div>

      <div className="mt-7 grid grid-cols-2 gap-3 lg:grid-cols-4">
        <StatCard
          icon={Footprints}
          label="Total steps"
          value={stats.steps}
          change="+12.8%"
          progress={stepsProgress}
          delay={0}
        />
        <StatCard
          icon={Flame}
          label="Calories burned"
          value={stats.calories}
          unit="kcal"
          change="+8.2%"
          color="#FF9E86"
          delay={0.08}
        />
        <StatCard
          icon={Clock3}
          label="Active time"
          value={stats.minutes}
          unit="min"
          change="+15 min"
          color="#A6A0FF"
          progress={activeProgress}
          delay={0.16}
        />
        <StatCard
          icon={Heart}
          label="Resting heart rate"
          value={stats.heartRate}
          unit="bpm"
          color="#FF8EAA"
          delay={0.24}
        />
      </div>

      <div className="mt-5 grid gap-5 lg:grid-cols-[1.6fr_1fr]">
        <div className="panel min-w-0 p-4 sm:p-6">
          <div className="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
            <div>
              <h3 className="font-display text-lg font-bold">
                Weekly activity
              </h3>
              <p className="mt-1 text-xs text-[#858b7e]">
                Your movement over the last seven days
              </p>
            </div>

            <div className="flex w-fit gap-1 rounded-xl border border-[#30362b] bg-[#11130f] p-1">
              {[
                { label: "Steps", value: "steps" },
                { label: "Calories", value: "calories" },
              ].map((item) => (
                <button
                  key={item.value}
                  type="button"
                  onClick={() => setMetric(item.value)}
                  className={`rounded-lg px-3 py-2 text-[11px] font-semibold transition-colors ${
                    metric === item.value
                      ? "bg-[#c1fa70] text-[#15180f]"
                      : "text-[#858b7e] hover:text-white"
                  }`}
                >
                  {item.label}
                </button>
              ))}
            </div>
          </div>

          <div className="mt-5 h-[245px] w-full">
            <ResponsiveContainer width="100%" height="100%">
              <AreaChart
                data={chartData}
                margin={{ top: 10, right: 4, left: -18, bottom: 0 }}
              >
                <defs>
                  <linearGradient
                    id="activityGradient"
                    x1="0"
                    y1="0"
                    x2="0"
                    y2="1"
                  >
                    <stop
                      offset="0%"
                      stopColor="#C1FA70"
                      stopOpacity={0.25}
                    />
                    <stop
                      offset="100%"
                      stopColor="#C1FA70"
                      stopOpacity={0}
                    />
                  </linearGradient>
                </defs>

                <CartesianGrid
                  stroke="#2b3027"
                  strokeDasharray="4 5"
                  vertical={false}
                />

                <XAxis
                  dataKey="day"
                  axisLine={false}
                  tickLine={false}
                  tick={{ fill: "#858b7e", fontSize: 11 }}
                  dy={10}
                />

                <YAxis
                  axisLine={false}
                  tickLine={false}
                  tick={{ fill: "#858b7e", fontSize: 10 }}
                  tickFormatter={(value) =>
                    value >= 1000
