          <div className="flex items-center justify-between">
            <div>
              <h3 className="font-display text-lg font-bold">
                Workout streak
              </h3>
              <p className="mt-1 text-xs text-[#858b7e]">
                Completed sessions in this browser
              </p>
            </div>
            <span className="flex h-11 w-11 items-center justify-center rounded-xl bg-[#ff9e8615] text-[#ff9e86]">
              <Flame size={22} />
